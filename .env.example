# ---------------------------------------------------------------------------
# All values below are SERVER-SIDE secrets. Set them in your host's environment
# (e.g. Render > Environment). Never commit a real .env file.
# Anything prefixed VITE_ is bundled into the public website, so only put
# non-secret public IDs there.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=""

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: REQUIRED. Password for the VELLURE admin dashboard (/admin).
# There is no default. Use at least 12 characters (a long random passphrase).
# If it is unset or shorter than 12 characters, admin login is disabled.
ADMIN_PASSWORD=""

# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID: Telegram bot for order and cart alerts.
# Sent by the server only; never exposed to browsers.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google Sheets inventory sync (Google Apps Script web app)
# GOOGLE_SHEET_WEBHOOK_URL: the Apps Script "Web app" URL (treat it like a secret).
# GOOGLE_SHEET_WEBHOOK_SECRET: long random string; set the SAME value as the
# WEBHOOK_SECRET script property in Apps Script (the script rejects requests without it).
GOOGLE_SHEET_WEBHOOK_URL=""
GOOGLE_SHEET_WEBHOOK_SECRET=""
GOOGLE_SHEET_NAME="Vellure Fragrances - Inventory"
GOOGLE_SHEET_EMAIL=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_RANGE="Sheet1!A2:E"

# Public analytics IDs (these are public by nature, safe to bundle)
# VITE_META_PIXEL_ID: Meta Pixel ID, e.g. 1234567890123456
VITE_META_PIXEL_ID=""
# VITE_GA4_MEASUREMENT_ID: Google Analytics 4 ID, e.g. G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=""
